# Database (Django + RAG use these)
# Local: use localhost. Supabase: use values from Supabase Connect screen.
DJANGO_DB_ENGINE=django.db.backends.postgresql
DB_NAME=mentalhealthdb
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
# Optional when using Supabase (default is require)
# DB_SSLMODE=require

# Optional
# N8N_SEND_OTP_WEBHOOK_URL=http://localhost:5678/webhook-test/send-otp-mindease
# TTS_BACKEND=qwen3
