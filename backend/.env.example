# Database (Django + RAG use these)
# Local: use localhost. Supabase: use values from Supabase Connect screen.
DJANGO_DB_ENGINE=django.db.backends.postgresql
DB_NAME=mentalhealthdb
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
# Optional when using Supabase (default is require)
# DB_SSLMODE=require

# Optional
# N8N_SEND_OTP_WEBHOOK_URL=http://localhost:5678/webhook-test/send-otp-mindease
# TTS: default is Qwen3 (no env needed). To use Coqui XTTS instead: TTS_BACKEND=xtts
# TTS_BACKEND=xtts
# Qwen3 on GPU: explicit half dtype (default auto: bf16 if supported else fp16).
# MINDEASE_QWEN3_DTYPE=bf16
# MINDEASE_QWEN3_DTYPE=fp16
# Fail load if FA2 cannot be used (CUDA + flash-attn + verified attn_implementation):
# MINDEASE_QWEN3_REQUIRE_FLASH=1
# Set only if FA2 crashes on your CUDA build (keeps half precision, disables FA2):
# MINDEASE_QWEN3_DISABLE_FLASH=1
# Warm up Qwen3 when the HTTP server starts (runserver child / gunicorn / uvicorn). Off: 0
# MINDEASE_QWEN3_WARMUP=0
# Force warmup even for manage.py commands that set WARMUP=1 (still skips autoreload parent):
# MINDEASE_QWEN3_WARMUP=1
# Qwen3 TTS chunking (optional): below MIN_SPLIT_CHARS → single synthesis pass (faster for short replies).
# MINDEASE_QWEN3_TTS_MIN_SPLIT_CHARS=880
# Max size when splitting long text (sentence-safe packing).
# MINDEASE_QWEN3_TTS_CHUNK_CHARS=720
